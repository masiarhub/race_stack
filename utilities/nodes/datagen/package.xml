<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>datagen</name>
  <version>0.0.0</version>
  <description>Simulated head-to-head data generation for opponent prediction</description>
  <maintainer email="metemadi@ethz.ch">Masiar Etemadi</maintainer>
  <license>MIT</license>

  <test_depend>python3-pytest</test_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <depend>rclpy</depend>
  <depend>ackermann_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>f110_msgs</depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>stack_master</exec_depend>
  <exec_depend>f1tenth_gym_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
